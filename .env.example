# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# App Configuration
APP_VERSION=1.0.0
DEBUG=true

# Reviewer Dashboard
REVIEWER_PASSWORD=njit-reviewer-2026
