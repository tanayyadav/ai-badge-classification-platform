# Database
DATABASE_URL=sqlite:///./badges.db

# NLP Configuration
USE_LLM=false                    # Set to true to enable LLM gap filling
SPACY_MODEL=en_core_web_sm       # Change to en_core_web_md for vector similarity

# LLM Configuration (only needed if USE_LLM=true)
